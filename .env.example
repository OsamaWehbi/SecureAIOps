# ---------------------------------------------------------------------------
# SecureAIOps configuration — copy to .env and adjust. Never commit .env.
# ---------------------------------------------------------------------------

APP_ENV=development            # development | production | test
LOG_LEVEL=INFO
LOG_JSON=false                 # true -> structured JSON logs (SIEM-friendly)

# --- Reasoning engine -------------------------------------------------------
# auto    -> Gemini when GEMINI_API_KEY is set, otherwise the offline engine
# gemini  -> always use Gemini (falls back per-step if a call fails)
# offline -> deterministic engine; no data leaves the host
LLM_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-2

# --- Persistence ------------------------------------------------------------
# Leave empty for a local SQLite file (demo). Production requires PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://secureaiops:<password>@localhost:5432/secureaiops
DATABASE_URL=
POSTGRES_PASSWORD=change-me-to-a-long-random-value

# --- Retrieval --------------------------------------------------------------
KB_BACKEND=local               # local (BM25) | pgvector (run scripts/ingest_knowledge.py first)
KB_TOP_K=3

# --- API security -----------------------------------------------------------
# Comma-separated keys. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
RATE_LIMIT_PER_MINUTE=30
MAX_INPUT_CHARS=12000

# --- Guardrails -------------------------------------------------------------
GUARD_BLOCK_THRESHOLD=0.65
GUARD_USE_LLM=true
